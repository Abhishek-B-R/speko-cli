{
  "name": "@spekoai/cli",
  "version": "0.1.0",
  "description": "Speko command-line interface: sign in, build and operate voice agents from the terminal",
  "license": "MIT",
  "author": "Speko",
  "homepage": "https://github.com/SpekoAI/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpekoAI/cli.git"
  },
  "bugs": {
    "url": "https://github.com/SpekoAI/cli/issues"
  },
  "keywords": [
    "speko",
    "spekoai",
    "cli",
    "voice-ai",
    "voice-agent",
    "stt",
    "tts",
    "agent",
    "claude-code"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "speko-cli": "dist/index.js"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@spekoai/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^25",
    "typescript": "~6.0.3",
    "vitest": "~4.1.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
